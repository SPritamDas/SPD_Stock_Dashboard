# ============================================================================
#  SECRETS TEMPLATE  —  copy to  .streamlit/secrets.toml  for LOCAL runs,
#  and paste the SAME content into Streamlit Cloud → app → Settings → Secrets.
#  The real .streamlit/secrets.toml is git-ignored and must NEVER be committed.
# ============================================================================

# ── 1. Google OAuth client  (lets friends sign in with Google via st.login) ──
#    Create at: Google Cloud Console → APIs & Services → Credentials →
#    "Create OAuth client ID" → Web application.
#    Authorized redirect URIs to add there:
#       local : http://localhost:8501/oauth2callback
#       cloud : https://<your-app-name>.streamlit.app/oauth2callback
[auth]
redirect_uri      = "http://localhost:8501/oauth2callback"   # change to the cloud URL when deployed
cookie_secret     = "CHANGE-ME-to-a-long-random-string"      # any long random string
client_id         = "xxxxxxxx.apps.googleusercontent.com"
client_secret     = "GOCSPX-xxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── 2. Service account  (read your Google Sheets: classifications + FII/DII) ──
#    Paste the NEWLY-ROTATED service-account JSON fields here (keep the \n in the key).
[gcp_service_account]
type                        = "service_account"
project_id                  = "sheet-operations-spritamdas"
private_key_id              = "<from new JSON>"
private_key                 = "-----BEGIN PRIVATE KEY-----\n<from new JSON>\n-----END PRIVATE KEY-----\n"
client_email                = "spritamdas@sheet-operations-spritamdas.iam.gserviceaccount.com"
client_id                   = "<from new JSON>"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "<from new JSON>"
universe_domain             = "googleapis.com"

# ── 3. App config ────────────────────────────────────────────────────────────
[app]
session_timeout_min = 240    # auto-logout after this many minutes of inactivity
dev_no_auth         = false  # LOCAL TESTING ONLY: true = bypass Google sign-in. NEVER set true in prod.
# The email allow-list currently lives in code (auth.py -> ALLOWED_EMAILS). To move it to a
# Sheet later, add allowlist_sheet_key / allowlist_worksheet here and read them in auth.py.

# ── 4. GitHub  (so the app can download the nightly cache Release asset) ──────
#    Create a FINE-GRAINED PAT with only  Contents: Read-only  on this one repo.
[github]
repo        = "<your-github-username>/SPD_Stock_Dashboard"
token       = "github_pat_xxxxxxxxxxxxxxxx"   # Contents: Read-only
release_tag = "data-latest"
cache_asset = "dashboard_cache.pkl"
